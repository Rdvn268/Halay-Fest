# Gateway bu dosyayı otomatik yüklemez. PowerShell örneği:
# $env:DATABASE_PATH='data/halay-fest.sqlite'
DATABASE_PATH=data/halay-fest.sqlite
# Ses dosyaları DATABASE_PATH + .music klasöründe tutulur; DB ile birlikte yedekleyin.
# Tüm servisler 127.0.0.1'e bağlıdır. Varsayılan gateway 8787.
# Şifre, TikTok çerezi veya gerçek yayın verisi eklemeyin.
