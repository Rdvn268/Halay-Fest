{
  "name": "halay-fest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HALAY FEST Phase 0 repository audit tooling; no game implementation yet",
  "engines": {
    "node": ">=24.13.1 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.8.0",
  "scripts": {
    "dev": "npm run build --silent && node dist/scripts/serve-legacy.js",
    "lint": "eslint scripts test --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "tsc -p tsconfig.build.json",
    "audit:legacy": "npm run build --silent && node dist/scripts/audit-cli.js",
    "check:legacy": "npm run build --silent && node dist/scripts/audit-cli.js --require-source",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "overrides": {
    "minimatch": "11.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
